# ---- Supabase (Project settings > API) ----
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=paste-service-role-key   # server only, never share

# ---- Paystack (Settings > API keys & webhooks) ----
PAYSTACK_SECRET_KEY=sk_test_xxx                    # use sk_live_xxx when verified

# ---- Resend (API keys) ----
RESEND_API_KEY=re_xxx
EMAIL_FROM="Tiada Marketplace <onboarding@resend.dev>"   # change to orders@yourdomain once verified
ADMIN_ALERT_EMAIL=you@gmail.com                      # where new-order alerts go

# ---- App ----
SITE_URL=https://tiada-marketplace.vercel.app
SESSION_SECRET=generate-a-long-random-string-at-least-32-characters
SETUP_TOKEN=another-long-random-string-used-once-to-create-the-owner-account
